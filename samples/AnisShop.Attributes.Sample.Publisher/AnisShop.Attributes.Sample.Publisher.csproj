<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A reference KafkaFlow PRODUCER for the same event contract the query side consumes. It is a
    sample, not part of the running service: it shows a command service how to publish events so the
    KafkaFlow listener's ordering and projection guarantees hold. See docs/kafkaflow-publisher.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />
    <PackageReference Include="KafkaFlow" Version="4.2.0" />
    <PackageReference Include="KafkaFlow.Microsoft.DependencyInjection" Version="4.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
